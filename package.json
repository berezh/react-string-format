        "@types/react": "^19.2.7",
        "@types/react-test-renderer": "^19.1.0",
        "eslint-config-varp": "^2.14.0",
        "jest": "^24.9.0",
        "react": "^19.2.3",
        "react-test-renderer": "^19.2.3",
